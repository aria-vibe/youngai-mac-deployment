+static void vision_linear(uint32_t M, uint32_t N, uint32_t K) {
+    float *x = malloc(M*K*4), *w = malloc(N*K*4), *ref = malloc(M*N*4), *got = malloc(M*N*4), *bias = malloc(N*4);
+    uint8_t *raw = malloc(N*K*2);
+    test_v41_fill_bf16(x, M*K, 1); test_v41_fill_bf16(bias, N, .1f);
+    test_v41_make_weights(V41_WT_BF16, N, K, raw, w);
+    ds4_gpu_tensor *tx = test_v41_tensor(x, M*K*4), *tw = test_v41_tensor(raw, N*K*2), *tb = test_v41_tensor(bias, N*4);
+    ds4_gpu_tensor *to = test_v41_tensor(NULL, M*N*4);
+    TEST_ASSERT(ds4_gpu_v41_matmul_bf16_dev_tensor(to, tw, K, N, tx, M));
+    TEST_ASSERT(test_v41_read(to, got, M*N*4));
+    test_v41_ref_matmul(x, w, ref, M, N, K, 0);
+    test_v41_cmp("vision BF16 device GEMM", got, ref, M*N, 1e-5f, 1e-3f);
+    for (uint32_t i=0;i<M*N;i++) ref[i]=test_v41_bf16r(got[i]+bias[i%N]);
+    TEST_ASSERT(ds4_gpu_v41_bias_add_dev_tensor(to, tb, M, N) && test_v41_read(to, got, M*N*4));
+    test_v41_cmp("vision bias then BF16",got,ref,M*N,0,0);
+    TEST_ASSERT(!ds4_gpu_v41_matmul_bf16_dev_tensor(to, tw, K+8, N, tx, M));
+    ds4_gpu_tensor_free(tx);ds4_gpu_tensor_free(tw);ds4_gpu_tensor_free(tb);ds4_gpu_tensor_free(to);
+    free(x);free(w);free(ref);free(got);free(bias);free(raw);
+}
+static void vision_elementwise(void) {
+    enum {N=5,D=72}; float x[N*D],w[D],ref[N*D],got[N*D],gu[N*D*2];
+    test_v41_fill_bf16(x,N*D,4);test_v41_fill_bf16(w,D,1);test_v41_fill_bf16(gu,N*D*2,8);
+    ds4_gpu_tensor *tx=test_v41_tensor(x,sizeof x),*tw=test_v41_tensor(w,sizeof w),*to=test_v41_tensor(NULL,sizeof x);
+    ds4_gpu_tensor *tg=test_v41_tensor(gu,sizeof gu);
+    TEST_ASSERT(ds4_gpu_v41_rms_norm_dev_tensor(to,tx,tw,D,N,1e-6f) && test_v41_read(to,got,sizeof got));
+    for (uint32_t t=0;t<N;t++) {
+        double ss=0;for(uint32_t d=0;d<D;d++)ss+=(double)x[t*D+d]*x[t*D+d];
+        float inv=1/sqrtf((float)(ss/D)+1e-6f);
+        for(uint32_t d=0;d<D;d++)ref[t*D+d]=test_v41_bf16r(w[d]*(x[t*D+d]*inv));
+    }
+    test_v41_cmp("vision device RMSNorm",got,ref,N*D,0.01f,1e-3f);
+    TEST_ASSERT(ds4_gpu_v41_swiglu_pair_tensor(to,tg,N,D) && test_v41_read(to,got,sizeof got));
+    for(uint32_t i=0;i<N*D;i++) { uint32_t b=(i/D)*2*D+i%D;float g=gu[b];ref[i]=test_v41_bf16r(g/(1+expf(-g))*gu[b+D]); }
+    test_v41_cmp("vision unclipped SwiGLU",got,ref,N*D,0.008f,1e-3f);
+    TEST_ASSERT(ds4_gpu_v41_gelu_tensor(tx,N*D) && test_v41_read(tx,got,sizeof got));
+    for(uint32_t i=0;i<N*D;i++)ref[i]=test_v41_bf16r(0.5f*x[i]*(1+erff(x[i]*0.70710678118654752f)));
+    test_v41_cmp("vision erf GELU",got,ref,N*D,0.008f,1e-3f);
+    ds4_gpu_tensor_free(tx);ds4_gpu_tensor_free(tw);ds4_gpu_tensor_free(to);ds4_gpu_tensor_free(tg);
+}
+static void vision_rope_attn(uint32_t N, int batched) {
+    const uint32_t H=2,D=64,HD=H*D,W=3*HD,NW=7;
+    float *qkv=malloc(N*W*4),*got=malloc(N*W*4),*ref=malloc(N*W*4),*prob=malloc(N*4);
+    test_v41_fill_bf16(qkv,N*W,1);memcpy(ref,qkv,N*W*4);
+    for(uint32_t t=0;t<N;t++)for(uint32_t h=0;h<H;h++)for(uint32_t j=0;j<D/2;j++) {
+        float pos=j<D/4?(float)(t/NW):(float)(t%NW);
+        float f=pos/powf(10000.f,(float)(2*(j%(D/4)))/(D/2)),c=cosf(f),s=sinf(f);
+        for(uint32_t p=0;p<2;p++) { float *b=ref+t*W+p*HD+h*D;float v=b[j],z=b[j+D/2];b[j]=test_v41_bf16r(v*c-z*s);b[j+D/2]=test_v41_bf16r(z*c+v*s); }
+    }
+    ds4_gpu_tensor *tq=test_v41_tensor(qkv,N*W*4),*to=test_v41_tensor(NULL,N*HD*4);
+    TEST_ASSERT(ds4_gpu_v41_vision_rope_tensor(tq,N,NW,H,D,10000) && test_v41_read(tq,got,N*W*4));
+    test_v41_cmp("vision 2D RoPE (V intact)",got,ref,N*W,.008f,1e-3f);
+    memcpy(qkv,got,N*W*4);
+    /* Independent scalar oracle, BF16 softmax then float accumulation. */
+    for(uint32_t t=0;t<N;t++)for(uint32_t h=0;h<H;h++) {
+        float mx=-INFINITY,den=0;
+        for(uint32_t k=0;k<N;k++) { double z=0;for(uint32_t d=0;d<D;d++)z+=(double)qkv[t*W+h*D+d]*qkv[k*W+HD+h*D+d];prob[k]=(float)z/sqrtf(D);mx=fmaxf(mx,prob[k]); }
+        for(uint32_t k=0;k<N;k++) {prob[k]=expf(prob[k]-mx);den+=prob[k];}
+        for(uint32_t k=0;k<N;k++)prob[k]=test_v41_bf16r(prob[k]/den);
+        for(uint32_t d=0;d<D;d++) {double z=0;for(uint32_t k=0;k<N;k++)z+=(double)prob[k]*qkv[k*W+2*HD+h*D+d];ref[t*HD+h*D+d]=test_v41_bf16r((float)z);}
+    }
+    uint64_t before=ds4_gpu_current_allocated_bytes(),scratch=ds4_gpu_v41_scratch_bytes();
+    for(int rep=0;rep<3;rep++) {
+        if(batched)TEST_ASSERT(ds4_gpu_begin_commands());
+        TEST_ASSERT(ds4_gpu_v41_dense_attn_tensor(to,tq,N,H,D));
+        if(batched)TEST_ASSERT(ds4_gpu_end_commands());
+        TEST_ASSERT(test_v41_read(to,got,N*HD*4));
+        test_v41_cmp("vision attention/chunk tail",got,ref,N*HD,.012f,1e-3f);
+        TEST_ASSERT(ds4_gpu_current_allocated_bytes() <= before+(1ull<<20));
+        TEST_ASSERT(ds4_gpu_v41_scratch_bytes()==scratch);
+    }
+    ds4_gpu_tensor_free(tq);ds4_gpu_tensor_free(to);free(qkv);free(got);free(ref);free(prob);
+}
+static void vision_rows_unfold(void) {
+    enum{NH=5,NW=7,D=8,R=3,OH=2,OW=3,OUT=OH*OW*D*R*R};
+    float x[NH*NW*D],got[OUT],ref[OUT];for(uint32_t i=0;i<NH*NW*D;i++)x[i]=(float)i;
+    ds4_gpu_tensor *tx=test_v41_tensor(x,sizeof x),*to=test_v41_tensor(NULL,sizeof got);
+    TEST_ASSERT(ds4_gpu_v41_vision_unfold_tensor(to,tx,NH,NW,D,R) && test_v41_read(to,got,sizeof got));
+    for(uint32_t y=0;y<OH;y++)for(uint32_t z=0;z<OW;z++)for(uint32_t d=0;d<D;d++)for(uint32_t a=0;a<R;a++)for(uint32_t b=0;b<R;b++)
+        ref[((y*OW+z)*D+d)*R*R+a*R+b]=y*R+a<NH && z*R+b<NW?x[((y*R+a)*NW+z*R+b)*D+d]:0;
+    test_v41_cmp("vision unfold + zero padding",got,ref,OUT,0,0);
+    const int32_t rows[5]={-1,4,0,-1,2};ds4_gpu_tensor *tr=test_v41_tensor(rows,sizeof rows);
+    TEST_ASSERT(ds4_gpu_v41_row_select_tensor(to,tx,tr,5,D) && test_v41_read(to,got,5*D*4));
+    for(uint32_t i=0;i<5*D;i++)if(rows[i/D]>=0)ref[i]=x[rows[i/D]*D+i%D];
+    test_v41_cmp("vision mixed text/image rows",got,ref,5*D,0,0);
+    TEST_ASSERT(ds4_gpu_v41_rows_zero_tensor(to,tr,5,D) && test_v41_read(to,got,5*D*4));
+    for(uint32_t i=0;i<5*D;i++)if(rows[i/D]>=0)ref[i]=0;
+    test_v41_cmp("vision masked Engram rows",got,ref,5*D,0,0);
+    TEST_ASSERT(!ds4_gpu_v41_vision_unfold_tensor(to,tx,NH,NW,D,0));
+    ds4_gpu_tensor_free(tx);ds4_gpu_tensor_free(to);ds4_gpu_tensor_free(tr);
+}
+static void vision_router(void) {
+    enum{N=5,E=64,K=3};float bias[E],vl[E],delta[E],lg[N*E],got[N*K];int32_t sel[N*K],rows[N]={-1,0,-1,4,7};
+    TEST_ASSERT(test_v41_model_begin(4096));uint64_t off=test_v41_model_alloc(E*4);
+    for(uint32_t e=0;e<E;e++){bias[e]=e;vl[e]=E-e;delta[e]=0;}
+    delta[3]=1000;memcpy(test_v41_model_ptr(off),bias,sizeof bias);TEST_ASSERT(test_v41_map());
+    for(uint32_t i=0;i<N*E;i++)lg[i]=0;
+    ds4_gpu_tensor *tl=test_v41_tensor(lg,sizeof lg),*tb=test_v41_tensor(vl,sizeof vl),*tr=test_v41_tensor(rows,sizeof rows);
+    ds4_gpu_tensor *ts=test_v41_tensor(NULL,sizeof sel),*tw=test_v41_tensor(NULL,sizeof got);
+    for(int override=0;override<2;override++) {
+        if(override)TEST_ASSERT(ds4_gpu_v41_set_rb_override(test_v41_model_map(),test_v41_model_size(),off,delta,E));
+        TEST_ASSERT(ds4_gpu_v41_router_tensor(ts,tw,tl,test_v41_model_map(),test_v41_model_size(),off,tb,tr,N,E,K,1.5f));
+        TEST_ASSERT(test_v41_read(ts,sel,sizeof sel) && test_v41_read(tw,got,sizeof got));
+        for(uint32_t t=0;t<N;t++)for(uint32_t k=0;k<K;k++) {
+            int32_t expected=rows[t]>=0?(int32_t)k:override?(k==0?3:(int32_t)(E-k)):(int32_t)(E-1-k);
+            TEST_ASSERT(sel[t*K+k]==expected);TEST_ASSERT(fabsf(got[t*K+k]-.5f)<1e-6f);
+        }
+    }
+    TEST_ASSERT(ds4_gpu_v41_set_rb_override(test_v41_model_map(),test_v41_model_size(),off,NULL,E));
+    ds4_gpu_tensor_free(tl);ds4_gpu_tensor_free(tb);ds4_gpu_tensor_free(tr);ds4_gpu_tensor_free(ts);ds4_gpu_tensor_free(tw);
+    fprintf(stderr,"ds4: [v41-test] vision routing respects image mask and text-only correction\n");
+}
+void test_metal_v41_vision(void) {
