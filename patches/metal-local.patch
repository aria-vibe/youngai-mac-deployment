index 0000000..d9e9f44
--- /dev/null
+++ b/src/core/core_v41_prefill.c
@@ -0,0 +1,149 @@
+/* Memory-aware Metal prefill. Failed forwards have already mutated KV/windows:
+ * never retry in-place. Drain, destroy, and restore an immutable checkpoint. */
+#include "core_internal.h"
+#ifndef DS4_NO_GPU
+
+/* Keep a full SWA window plus decoder replay in the smallest large-prompt
+ * chunk. Short suffixes still allocate only their actual rows (minimum 10). */
+#define V41_PREFILL_MIN_ROWS 256u
+#define V41_PREFILL_RESERVE (256ull * 1024 * 1024)
+
+uint64_t v41_prefill_oom_epoch(void) {
+#if defined(__APPLE__)
+    return ds4_gpu_memory_oom_epoch();
+#else
+    return 0;
+#endif
+}
+
+uint64_t v41_prefill_estimate_bytes(uint32_t rows, uint32_t ctx) {
+    const uint64_t E = DS4_N_EMBD, HC = DS4_N_HC, HD = DS4_N_HEAD_DIM;
+    const uint64_t SW = DS4_N_SWA, IK = DS4_N_INDEXER_HEAD_DIM, IH = DS4_N_INDEXER_HEAD;
+    /* Row tensors in core_v41_state.c, plus headroom for Metal kernel scratch
+     * and ordered-upload copies. A forecast, not a promise of allocation. */
+    uint64_t row = 4 * (3 + 2*HC*E + 6*E + 3*DS4_N_FF_EXP + 5*HC + 2*HC*HC +
+        DS4_N_EXPERT + 2*DS4_N_EXPERT_USED + 2*DS4_N_LORA_Q + 2*DS4_N_HEAD*HD +
+        6*HD + (uint64_t)DS4_N_OUT_GROUP*DS4_N_LORA_O + 1 + IK + IH*IK + IH + DS4_N_INDEXER_TOP_K);
+    uint64_t fixed = V41_PREFILL_RESERVE + E*4 + SW*HD*4 +
+        (uint64_t)(DS4_MTP_MAX_BLOCK + 2u)*DS4_N_VOCAB*4;
+    if (g_ds4_v41.mtp_block) fixed += SW*g_ds4_v41.n_mtp_target*E*4;
+    uint64_t groups = 0;
+    for (uint32_t l = 0; l < DS4_N_LAYER; l++) {
+        fixed += SW*HD*4; row += HD*4;
+        if (!g_ds4_v41.is_kv_source[l]) continue;
+        const uint32_t ratio = ds4_layer_compress_ratio(l);
+        if (!ratio) continue;
+        const uint64_t ng = (uint64_t)ctx/ratio + 2;
+        fixed += ng*(DS4_V41_CKV_BYTES + DS4_V41_IDXK_BYTES);
+        if (ng > groups) groups = ng;
+        if (ratio > 1) { fixed += (uint64_t)ratio*HD*8; row += HD*8; }
+    }
+    /* Index scores grow geometrically, and at most 64 query rows are scored
+     * together. Reserve the next growth bucket rather than just current ng. */
+    fixed += (rows < 64 ? rows : 64)*groups*8;
+    if (g_ds4_v41.candidate_source_layer >= 0 && g_ds4_v41.candidate_topk_blocks > 0)
+        row += 4ull*(1u + g_ds4_v41.candidate_topk_blocks);
+    const ds4_v41_cfg *v = &g_ds4_v41;
+    if (v->n_engram && v->engram_max_ngram > 1) {
+        const uint64_t cols = (uint64_t)(v->engram_max_ngram-1)*v->engram_heads;
+        row += v->n_engram*cols*(v->engram_head_dim + v->engram_head_dim/32u);
+        row += cols*v->engram_head_dim*4 + (HC+1)*E*4;
+    }
+    return fixed + (uint64_t)rows*(row + row/2);
+}
+
+uint32_t v41_prefill_choose_rows(uint32_t ceiling, uint32_t remaining, uint32_t ctx, uint64_t room) {
+    uint32_t rows = remaining < ceiling ? remaining : ceiling;
+    const uint32_t floor = DS4_MTP_MAX_BLOCK + 2u;
+    if (rows < floor) rows = floor;
+    if (rows > ctx) rows = ctx;
+    while (rows > V41_PREFILL_MIN_ROWS && v41_prefill_estimate_bytes(rows, ctx) > room) {
+        rows /= 2;
+        if (rows < V41_PREFILL_MIN_ROWS) rows = V41_PREFILL_MIN_ROWS;
+    }
+    return rows;
+}
+
+static bool metal(const ds4_engine *e) { return e->backend == DS4_BACKEND_METAL; }
+static uint64_t prefill_room(ds4_engine *e, uint64_t *base, uint64_t *limit) {
+    *base = ds4_gpu_current_allocated_bytes();
+    /* VQ model views are lazy; currentAllocated alone underestimates a cold
+     * request until its first MoE layer has mapped the model. */
+    if (*base < e->model.size) *base = e->model.size;
+    *limit = ds4_gpu_recommended_max_working_set_bytes();
+    const uint64_t budget = ds4_runtime_mem_budget_bytes();
+    if (budget && (!*limit || budget < *limit)) *limit = budget;
+    const uint64_t gpu = *limit > *base ? *limit - *base : 0;
+    const uint64_t host = ds4_runtime_mem_headroom_bytes();
+    return gpu < host ? gpu : host;
+}
+
+static uint32_t downshift(uint32_t rows) {
+    if (rows <= V41_PREFILL_MIN_ROWS) return 0;
+    rows /= 2;
+    return rows < V41_PREFILL_MIN_ROWS ? V41_PREFILL_MIN_ROWS : rows;
+}
+
+bool v41_prefill_alloc(ds4_engine *e, ds4_v41_state *st, const int32_t *prompt, uint32_t np, uint32_t ctx,
+                       uint32_t ceiling, const uint64_t *sig, uint32_t *reused) {
+    if (!metal(e)) return v41_kvreuse_alloc(st, prompt, np, ctx, ceiling, sig, reused);
+    const uint32_t pending = np - v41_kvreuse_planned(prompt, np, sig);
+    uint64_t base, limit;
+    const uint64_t room = prefill_room(e, &base, &limit);
+    uint32_t rows = v41_prefill_choose_rows(ceiling, pending, ctx, room);
+    fprintf(stderr, "[v41] adaptive prefill: pending=%u ceiling=%u rows=%u base=%.2f MiB limit=%.2f MiB room=%.2f MiB estimate=%.2f MiB\n",
+            pending, ceiling, rows, (double)base/1048576., (double)limit/1048576.,
+            (double)room/1048576., (double)v41_prefill_estimate_bytes(rows, ctx)/1048576.);
+    for (;;) {
+        const uint64_t epoch = v41_prefill_oom_epoch();
+        /* A tiny cached suffix can fall back to cold prefill if copying the
+         * checkpoint fails. That cold state still needs a replay-sized cap. */
+        const uint32_t chunk = rows < V41_PREFILL_MIN_ROWS && ceiling >= V41_PREFILL_MIN_ROWS ? V41_PREFILL_MIN_ROWS : rows;
+        if (v41_kvreuse_alloc(st, prompt, np, ctx, chunk, sig, reused)) return true;
+        (void)ds4_gpu_synchronize();
+        (void)ds4_gpu_v41_scratch_release();
+        const uint32_t next = downshift(rows);
+        if (v41_prefill_oom_epoch() == epoch || !next) return false;
+        fprintf(stderr, "[v41] prefill allocation OOM: rows=%u -> %u, rebuilding state\n", rows, next);
+        rows = next;
+    }
+}
+
+bool v41_prefill_run(ds4_engine *e, ds4_v41_state *st, const int32_t *prompt, uint32_t np,
+                     const uint64_t *sig, uint32_t *reused, ds4_v41_progress_fn progress, void *ud, v41_prefill_step_fn step) {
+    uint32_t c0 = *reused;
+    for (;;) {
+        const uint64_t epoch = v41_prefill_oom_epoch();
+        bool ok = true;
+        while (ok && c0 < np) {
+            ok = step(e, st, prompt, np, &c0, st->cap_tok);
+            if (ok && progress && progress(ud, "prefill_chunk", (int)c0, (int)np)) {
+                fprintf(stderr, "[v41] prefill cancelled at %u/%u\n", c0, np);
+                return false;
+            }
+        }
+        if (ok) return true;
+        (void)ds4_gpu_synchronize();
+        const uint32_t next = downshift(st->cap_tok);
+        if (!metal(e) || v41_prefill_oom_epoch() == epoch || !next) return false;
+        /* Check cancellation before expensive replay too. No generated token
+         * has been emitted; the request's RNG/sampling state is unchanged. */
+        if (progress && progress(ud, "prefill_chunk", (int)c0, (int)np)) return false;
+        const uint32_t ctx = st->ctx;
+        const ds4_gpu_sample_params samp = st->samp;
+        const int dev_sample = st->dev_sample;
+        const struct ds4_v41_images *images = st->vimg;
+        fprintf(stderr, "[v41] prefill OOM: at=%u/%u rows=%u -> %u; discard partial KV and restore checkpoint\n",
+                c0, np, st->cap_tok, next);
+        v41_state_free(st);
