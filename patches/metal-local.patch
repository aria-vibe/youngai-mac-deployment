+// Request-local vision tower. Concatenated after v41_common and unary (erf).
+kernel void kernel_v41_vis_bias(constant v41_n_args &a [[buffer(0)]], device float *x [[buffer(1)]],
+                                device const float *b [[buffer(2)]], uint i [[thread_position_in_grid]]) {
+    if (i < a.n0) x[i] = v41_bf16r(x[i] + b[i % a.n1]);
+}
+kernel void kernel_v41_vis_rope(constant v41_n_args &a [[buffer(0)]], device float *qkv [[buffer(1)]], uint i [[thread_position_in_grid]]) {
+    const uint rd = a.n3 / 2u, nf = rd / 2u;
+    if ((ulong)i >= (ulong)a.n0 * a.n2 * rd) return;
+    const uint j = i % rd, h = (i / rd) % a.n2, t = i / (rd * a.n2);
+    const uint fi = j < nf ? j : j - nf;
+    const float pos = j < nf ? float(t / a.n1) : float(t % a.n1);
+    const float f = pos / pow(a.f0, float(2u * fi) / float(rd)), c = cos(f), s = sin(f);
+    for (uint part = 0; part < 2u; part++) {
+        device float *b = qkv + ((ulong)t * 3u * a.n2 + part * a.n2 + h) * a.n3;
+        const float x1 = b[j], x2 = b[j + rd];
+        b[j] = v41_bf16r(x1 * c - x2 * s); b[j + rd] = v41_bf16r(x2 * c + x1 * s);
+    }
+}
+// P occupies S's buffer. Preserve CUDA's BF16 softmax boundary before P*V.
+kernel void kernel_v41_vis_softmax(constant v41_n_args &a [[buffer(0)]], device float *p [[buffer(1)]],
+                                   uint row [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {
+    threadgroup float red[256];
+    device float *s = p + (ulong)row * a.n0;
+    float m = -INFINITY;
+    for (uint k = tid; k < a.n0; k += 256u) m = max(m, s[k] * a.f0);
+    red[tid] = m; threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint d = 128u; d; d >>= 1u) {
+        if (tid < d) red[tid] = max(red[tid], red[tid + d]);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    m = red[0]; threadgroup_barrier(mem_flags::mem_threadgroup);
+    float sum = 0.0f;
+    for (uint k = tid; k < a.n0; k += 256u) sum += exp(s[k] * a.f0 - m);
+    const float den = v41_tg_sum(sum, red, tid, 256u);
+    for (uint k = tid; k < a.n0; k += 256u) s[k] = v41_bf16r(exp(s[k] * a.f0 - m) / den);
+}
+kernel void kernel_v41_vis_swiglu(constant v41_n_args &a [[buffer(0)]], device float *h [[buffer(1)]],
+                                  device const float *gu [[buffer(2)]], uint i [[thread_position_in_grid]]) {
+    if (i >= a.n0) return;
+    const ulong base = (ulong)(i / a.n1) * 2u * a.n1 + i % a.n1;
+    const float g = gu[base], u = gu[base + a.n1];
+    h[i] = v41_bf16r((g / (1.0f + exp(-g))) * u);
+}
+kernel void kernel_v41_vis_gelu(device float *x [[buffer(0)]], constant ulong &n [[buffer(1)]], uint i [[thread_position_in_grid]]) {
+    if ((ulong)i < n) {
+        const float v = x[i];
+        // A&S 7.1.26 error <=1.5e-7; erf-GELU rather than tanh-GELU.
+        x[i] = v41_bf16r(0.5f * v * (1.0f + erf_approx<float>(v * 0.70710678118654752f)));
+    }
+}
+kernel void kernel_v41_vis_unfold(constant v41_n_args &a [[buffer(0)]], device float *out [[buffer(1)]], device const float *x [[buffer(2)]],
+                                  constant ulong &n [[buffer(3)]], uint i [[thread_position_in_grid]]) {
+    if ((ulong)i >= n) return;
+    const uint r = a.n3, ow = (a.n1 + r - 1u) / r, cols = a.n2 * r * r;
+    const uint col = i % cols, cell = i / cols, c = col / (r * r), rem = col % (r * r);
+    const uint pi = (cell / ow) * r + rem / r, pj = (cell % ow) * r + rem % r;
+    out[i] = pi < a.n0 && pj < a.n1 ? x[((ulong)pi * a.n1 + pj) * a.n2 + c] : 0.0f;
+}
+kernel void kernel_v41_vis_select(constant v41_n_args &a [[buffer(0)]], device float *x [[buffer(1)]], device const float *src [[buffer(2)]],
+                                  device const int *rows [[buffer(3)]], uint i [[thread_position_in_grid]]) {
+    if (i >= a.n0) return;
+    const int r = rows[i / a.n1];
+    if (r >= 0 && (uint)r < a.n2) x[i] = src[(ulong)r * a.n1 + i % a.n1];
+}
+kernel void kernel_v41_vis_zero(constant v41_n_args &a [[buffer(0)]], device float *x [[buffer(1)]], device const int *rows [[buffer(2)]],
+                                uint i [[thread_position_in_grid]]) {
+    if (i < a.n0 && rows[i / a.n1] >= 0) x[i] = 0.0f;
+}
+// Patch projection has K=3*14*14=588, not divisible by eight. Generic wgemm's
+// vector decoder requires K%8==0, so guard each scalar load in this tail path.
+kernel void kernel_v41_vis_wgemm(constant v41_wgemm_args &a [[buffer(0)]], device const ushort *w [[buffer(1)]],
+                                 device const float *x [[buffer(2)]], device float *out [[buffer(3)]], device const uchar *unused [[buffer(4)]],
+                                 uint3 tg [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]],
+                                 uint sg [[simdgroup_index_in_threadgroup]]) {
+    (void)unused;
+    threadgroup float As[64*16],Bs[16*64],Cs[64*64];
+    const uint m0=tg.y*64u,n0=tg.x*64u,sm=(sg>>1)*32u,sn=(sg&1u)*32u;
+    simdgroup_float8x8 acc[4][4];
+    for(uint i=0;i<4;i++)for(uint j=0;j<4;j++)acc[i][j]=simdgroup_float8x8(0.f);
+    for(uint k0=0;k0<a.K;k0+=16u) {
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for(uint e=tid;e<1024u;e+=128u) {
+            const uint m=m0+e/16u,k=k0+e%16u;
+            As[e]=m<a.M && k<a.K?x[(ulong)m*a.K+k]:0.f;
+            const uint wk=k0+e/64u,n=n0+e%64u;
+            Bs[e]=wk<a.K && n<a.N?as_type<float>((uint)w[(ulong)n*a.K+wk]<<16u):0.f;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for(uint kk=0;kk<16u;kk+=8u) {
+            simdgroup_float8x8 ma[4],mb[4];
+            for(uint i=0;i<4;i++)simdgroup_load(ma[i],As+(sm+8u*i)*16u+kk,16);
+            for(uint j=0;j<4;j++)simdgroup_load(mb[j],Bs+kk*64u+sn+8u*j,64);
+            for(uint i=0;i<4;i++)for(uint j=0;j<4;j++)simdgroup_multiply_accumulate(acc[i][j],ma[i],mb[j],acc[i][j]);
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for(uint i=0;i<4;i++)for(uint j=0;j<4;j++)simdgroup_store(acc[i][j],Cs+(sm+8u*i)*64u+sn+8u*j,64);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for(uint e=tid;e<4096u;e+=128u) {
+        const uint m=m0+e/64u,n=n0+e%64u;
+        if(m<a.M && n<a.N)out[(ulong)m*a.N+n]=Cs[e];
+    }
+}
