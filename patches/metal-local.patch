+        g_ds4_shape.n_layer = 3;
+        uint32_t reused = 0;
+        TEST_ASSERT(v41_kvreuse_alloc(&dst, prompt, np + 5, ctx, 2048, NULL, &reused));
+        TEST_ASSERT(reused == 0 && dst.n_past == 0 && dst.cap_tok == 2048);
+        float value = 1;
+        TEST_ASSERT(ds4_gpu_tensor_read(dst.win[0], 0, &value, 4) && value == 0);
+        v41_state_free(&dst);
+        g_ds4_shape.n_layer = 2;
+        fprintf(stderr, "ds4: [v41-test] prefix %u: exact / +5 reuse and failed-copy cold fallback passed\n", np);
+    }
+    test_adaptive_retry();
+    v41_kvreuse_drop();
+    /* A bad embedding range rejects the forward after begin_commands. It
+     * must close that batch so the next request can submit GPU work. */
+    ds4_v41_state st;
+    TEST_ASSERT(v41_state_alloc(&st, 10, 128, 10));
+    ds4_engine e = {0}; ds4_tensor bad_weight = {0};
+    e.weights.token_embd = &bad_weight;
+    for (int i = 0; i < 8; i++) {
+        TEST_ASSERT(!v41_forward(&e, &st, prompt, 1));
+        TEST_ASSERT(ds4_gpu_begin_commands());
+        TEST_ASSERT(ds4_gpu_end_commands());
+    }
+    v41_state_free(&st);
+    free(prompt);
+    g_ds4_shape = old_shape; g_ds4_v41 = old_cfg; g_ds4_compress_ratios[0] = old_ratio;
+}
+
+void test_metal_v41_memory(void) {
+    const uint64_t bytes = 4u * 1024u * 1024u;
+    float *host = calloc(1, (size_t)bytes);
+    TEST_ASSERT(host != NULL);
+    uint64_t baseline = 0, peak = 0;
+    for (int i = 0; i < 40; i++) {
+        ds4_gpu_tensor *a = ds4_gpu_tensor_alloc(bytes), *b = ds4_gpu_tensor_alloc(bytes);
+        TEST_ASSERT(a && b);
+        host[0] = (float)i;
+        TEST_ASSERT(ds4_gpu_tensor_write(a, 0, host, bytes));
+        TEST_ASSERT(ds4_gpu_begin_commands());
+        TEST_ASSERT(ds4_gpu_tensor_copy(b, 0, a, 0, bytes));
+        TEST_ASSERT(ds4_gpu_flush_commands());
+        TEST_ASSERT(ds4_gpu_tensor_write(a, 0, host, bytes));
+        TEST_ASSERT(ds4_gpu_tensor_copy(b, 0, a, 0, bytes));
+        TEST_ASSERT(ds4_gpu_end_commands());
+        TEST_ASSERT(ds4_gpu_synchronize());
+        float got = -1;
+        TEST_ASSERT(ds4_gpu_tensor_read(b, 0, &got, sizeof got));
+        TEST_ASSERT(got == (float)i);
+        ds4_gpu_tensor_free(a); ds4_gpu_tensor_free(b);
+        const uint64_t now = ds4_gpu_current_allocated_bytes();
+        if (i == 7) baseline = peak = now;
+        if (i >= 8 && now > peak) peak = now;
+    }
+    fprintf(stderr, "ds4: [v41-test] resources after 32 warmed cycles: baseline %.2f MiB, peak %.2f MiB\n",
+            (double)baseline / 1048576., (double)peak / 1048576.);
+    TEST_ASSERT(peak <= baseline + 16u * 1024u * 1024u);
+    free(host);
+    test_cached_workspace();
+}
+#else
+typedef int ds4_t_metal_v41_memory_nonempty_tu;
+#endif
