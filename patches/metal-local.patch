@@ -0,0 +1,51 @@
+/* Full vision golden gate without mapping/loading the 113 GB language model.
+ * Usage: ds4-vision-check sidecar.gguf image.png golden.bin
+ * Run under the deployment's external memory guardian. */
+#include "src/core/core_internal.h"
+#include "ds4_v41_api.h"
+int main(int argc, char **argv) {
+    if (argc != 4) { fprintf(stderr,"usage: %s sidecar.gguf image golden\n",argv[0]);return 2; }
+    ds4_engine *e=calloc(1,sizeof *e);if(!e)return 1;
+    model_open(&e->model,argv[1],false,false);
+    const ds4_tensor *al=model_find_tensor(&e->model,"mm.1.weight");
+    const ds4_tensor *bias=model_find_tensor(&e->model,"blk.0.exp_probs_b_vl.bias");
+    if(!al || !bias)return 1;
+    g_ds4_shape.variant=DS4_VARIANT_V41;g_ds4_shape.n_embd=(uint32_t)al->dim[0];g_ds4_shape.n_expert=(uint32_t)bias->dim[0];
+    g_ds4_shape.n_layer=0;
+    for(uint32_t i=0;i<DS4_MAX_LAYER;i++) {
+        char nm[64];snprintf(nm,sizeof nm,"blk.%u.exp_probs_b_vl.bias",i);
+        if(!model_find_tensor(&e->model,nm))break;
+        g_ds4_shape.n_layer++;
+    }
+    g_vision_model=&e->model;v41_load_vision_metadata(&e->model);weights_bind_vision(&e->weights,&e->model);
+    if(!ds4_gpu_init())return 1;
+    e->backend=DS4_BACKEND_METAL;e->metal_ready=true;
+    uint64_t before=ds4_gpu_current_allocated_bytes();
+    int rc=ds4_engine_v41_vision_golden(e,argv[2],argv[3]);
+    /* Fail after one completed ViT block, then retry the SAME prepared image.
+     * This guards the OOM/retry lifetime without exhausting the host's RAM. */
+    FILE *f=fopen(argv[2],"rb");
+    if(!f)return 1;
+    fseek(f,0,SEEK_END);long len=ftell(f);rewind(f);
+    uint8_t *bytes=malloc((size_t)len);
+    if(!bytes || fread(bytes,1,(size_t)len,f)!=(size_t)len)return 1;
+    fclose(f);
+    g_ds4_v41.ctx=1048576;
+    int prompt=g_ds4_v41.image_token_id,*tokens=NULL,np=0;char err[256];
+    ds4_v41_image_src src={.data=bytes,.len=(size_t)len};
+    struct ds4_v41_images *imgs=ds4_v41_images_prepare(e,&prompt,1,&src,1,&tokens,&np,err,sizeof err);
+    if(!imgs){fprintf(stderr,"prepare failed: %s\n",err);return 1;}
+    const ds4_tensor *saved=e->weights.vis.blk[1].qkv_w;
+    e->weights.vis.blk[1].qkv_w=NULL;
+    if(v41_vision_encode(e,imgs) || imgs->encoded || imgs->embd || !imgs->img[0].patches)rc=1;
+    e->weights.vis.blk[1].qkv_w=saved;
+    if(!v41_vision_encode(e,imgs) || !imgs->encoded || imgs->img[0].patches)rc=1;
+    ds4_v41_images_free(imgs);free(tokens);free(bytes);
+    for(uint32_t i=0;i<g_ds4_shape.n_layer;i++){ds4_gpu_tensor_free(g_v41_bias_vl[i]);g_v41_bias_vl[i]=NULL;}
+    if(!ds4_gpu_synchronize())rc=1;
+    uint64_t after=ds4_gpu_current_allocated_bytes();
+    fprintf(stderr,"vision-check memory: before=%llu after=%llu scratch=%llu\n",(unsigned long long)before,(unsigned long long)after,(unsigned long long)ds4_gpu_v41_scratch_bytes());
+    if(after>before+(1ull<<20))rc=1;
+    model_close(&e->model);g_vision_model=NULL;free(e);
+    return rc;
+}
