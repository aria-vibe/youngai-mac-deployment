+    TEST_ASSERT(v41_prefill_choose_rows(2048, 5487, 268353, UINT64_MAX) == 2048);
+    TEST_ASSERT(v41_prefill_choose_rows(2048, 5487, 268353, v41_prefill_estimate_bytes(512, 268353)) == 512);
+    TEST_ASSERT(v41_prefill_choose_rows(2048, 5487, 268353, 0) == 256);
+    TEST_ASSERT(v41_prefill_choose_rows(2048, 5, 1048576, 0) == 10);
+    int32_t *p = calloc(260151, 4);
+    TEST_ASSERT(p != NULL);
+    ds4_v41_state src, st;
+    v41_kvreuse_drop();
+    TEST_ASSERT(v41_state_alloc(&src, 10, 268353, 10));
