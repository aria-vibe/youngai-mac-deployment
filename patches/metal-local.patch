+/* Resource lifetime regression: the C server worker has no outer ObjC pool. */
+#include "test_internal.h"
+#if !defined(DS4_NO_GPU) && defined(__APPLE__)
+/* The server test header also declares its own public now_sec(). */
+#define now_sec core_test_now_sec
+#include "../src/core/core_internal.h"
+#undef now_sec
+
+static int retry_mode, retry_calls;
+static uint32_t retry_prefix;
+static bool retry_step(ds4_engine *e, ds4_v41_state *st, const int32_t *p, uint32_t np, uint32_t *c0, uint32_t cap) {
+    (void)e; (void)p;
+    retry_calls++;
+    if (*c0 == retry_prefix) {
+        float marker = -1;
+        TEST_ASSERT(st->n_past == retry_prefix && st->ctx == 268353);
+        TEST_ASSERT(ds4_gpu_tensor_read(st->win[0], 0, &marker, 4) && marker == 0);
+        TEST_ASSERT(st->mainh_n == 128 && st->mainh_end == (int64_t)retry_prefix-1);
+        TEST_ASSERT(st->samp.seed == 123 && st->dev_sample && st->head_last_only && st->half_prefill);
+    }
+    if (retry_mode == 2 || retry_mode == 3 || cap > 512) {
+        /* Corrupt a partial state with real queued GPU work before reporting
+         * an injected OOM. The next attempt must restore the checkpoint. */
+        TEST_ASSERT(ds4_gpu_begin_commands());
+        TEST_ASSERT(ds4_gpu_tensor_fill_f32(st->win[0], 99, 1));
+        st->n_past++;
+        if (retry_mode != 2) ds4_gpu_note_memory_oom();
+        return false;
+    }
+    const uint32_t n = np-*c0 < cap ? np-*c0 : cap;
+    *c0 += n; st->n_past += n;
+    return true;
+}
+static int retry_cancel(void *ud, const char *event, int now, int total) {
+    (void)ud; (void)event; (void)now; (void)total; return 1;
+}
